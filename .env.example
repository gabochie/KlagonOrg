# Supabase — copy to .env.local and fill in values from your project dashboard:
#   Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI sales agent ("Ama") — Cloudflare Worker URL (see workers/agent/wrangler.toml)
NEXT_PUBLIC_AGENT_URL=https://your-worker-name.your-subdomain.workers.dev

# Cloudflare Web Analytics beacon (pageviews; the Observability component
# renders nothing without it). Paste the beacon token from the Cloudflare
# dashboard (Analytics & Logs) here AND in Pages env vars.
NEXT_PUBLIC_CF_BEACON_TOKEN=your-beacon-token

# Moolre — Ghana mobile-money collections. These do NOT belong in .env.local:
# the static site never calls Moolre. They live in the payments Worker
# (workers/moolre), set with `wrangler secret put <NAME>` from that directory.
# These are the names the worker actually reads.
# MOOLRE_USER=
# MOOLRE_PUBKEY=
# MOOLRE_WALLET=

# Shared secret the worker sends as x-confirm-secret so only it can call the
# confirm_*_by_ref / create_*_order RPCs. Copy the value out of Supabase:
#   select value from public.app_secrets where key = 'confirm_secret';
# CONFIRM_SECRET=