# Supabase — copy to .env.local and fill in values from your project dashboard:
#   Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI sales agent ("Ama") — Cloudflare Worker URL (see workers/agent/wrangler.toml)
NEXT_PUBLIC_AGENT_URL=https://your-worker-name.your-subdomain.workers.dev

# Moolre (Phase 2 — not used by the static site; these live in the Cloudflare Worker)
# MOOLRE_API_USER=
# MOOLRE_PUBLIC_KEY=
# MOOLRE_ACCOUNT_NUMBER=